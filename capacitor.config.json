{
  "appId": "app.tempocal.tempo",
  "appName": "Tempo",
  "webDir": "public",
  "server": {
    "allowNavigation": [
      "tempocal.app",
      "*.firebaseapp.com",
      "*.googleapis.com"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "scheme": "Tempo"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["phone"]
    }
  }
}
