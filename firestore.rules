rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Gigs collection
    match /gigs/{gigId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bands collection
    match /bands/{bandId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Band Messages subcollection (text blasts)
    match /bands/{bandId}/messages/{messageId} {
      // Any authenticated user can read band messages
      allow read: if request.auth != null;
      // Any authenticated user can create messages
      allow create: if request.auth != null;
    }

    // Band Members collection
    match /bandMembers/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Rehearsals collection
    match /rehearsals/{rehearsalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Connections collection
    match /connections/{connectionId} {
      // Anyone can read connections they're part of
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.users;

      // Can create if authenticated and user is in the users array
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.users &&
        request.auth.uid == request.resource.data.requestedBy;

      // Can update/delete if authenticated and user is in the users array
      allow update, delete: if request.auth != null &&
        request.auth.uid in resource.data.users;
    }

    // Conversations collection - only participants can access
    match /conversations/{conversationId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants;
    }

    // Messages subcollection
    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.senderId;
      // Allow update/delete only by message sender
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.senderId;
    }

    // User's personal contacts subcollection
    match /users/{userId}/contacts/{contactId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // SMS Messages - only the sender can read their messages
    match /smsMessages/{messageId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.sentBy;
      // Only Cloud Functions can create/update (no client writes)
      allow write: if false;
    }

    // Optouts - Cloud Functions only for writes, but allow read to check status
    match /optouts/{phone} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // SMS opt-in consent records - written only by Cloud Functions (recordSmsOptIn).
    // Read restricted to admin/server; no client reads or writes.
    match /smsOptIns/{optInId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
