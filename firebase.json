{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/e/**",
        "function": "ogTags"
      },
      {
        "source": "/b/**",
        "function": "bandPreview"
      },
      {
        "source": "/bands",
        "destination": "/index.html"
      },
      {
        "source": "/profile",
        "destination": "/index.html"
      },
      {
        "source": "/band/**",
        "destination": "/index.html"
      },
      {
        "source": "/r/**",
        "destination": "/index.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/sms",
        "destination": "/sms.html"
      },
      {
        "source": "/sms-signup",
        "destination": "/sms-signup.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
